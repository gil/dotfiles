#!/usr/bin/env bash
set -e

usage() {
  echo "usage: ,compare-video-quality [options] <reference> <converted>" >&2
  echo "options:" >&2
  sed -n 's/^ *\(--[^)]*\)).* # \(.*\)$/  \1  \2/p' "$0" >&2
}

samples=5
seconds=10
full=false
model=vmaf_v0.6.1
display_height=
rest=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help | -h)
      usage
      exit 0
      ;;
    --full) full=true ;; # Score the whole video instead of samples (slow)
    --4k) model=vmaf_4k_v0.6.1 ;; # Use the 4K model (default is the 1080p model)
    --display=*) display_height="${1#--display=}" ;;
    --display) # Upscale both videos to this height before scoring, e.g. 1080 for a video watched fullscreen on a 1080p screen
      display_height="$2"
      shift
      ;;
    --samples=*) samples="${1#--samples=}" ;;
    --samples) # Number of clips, spread evenly across the video (default 5)
      samples="$2"
      shift
      ;;
    --seconds=*) seconds="${1#--seconds=}" ;;
    --seconds) # Length of each clip in seconds (default 10)
      seconds="$2"
      shift
      ;;
    *) rest+=("$1") ;;
  esac
  shift
done

if [[ ${#rest[@]} -ne 2 ]]; then
  usage
  exit 1
fi

if [[ ! "$samples" =~ ^[1-9][0-9]*$ || ! "$seconds" =~ ^[1-9][0-9]*$ ]]; then
  echo "--samples and --seconds must be positive whole numbers" >&2
  exit 1
fi

if [[ -n "$display_height" && ! "$display_height" =~ ^[1-9][0-9]*$ ]]; then
  echo "--display must be a positive whole number" >&2
  exit 1
fi

reference="${rest[0]}"
converted="${rest[1]}"

duration=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$reference")
size=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=s=x:p=0 "$reference")
threads=$(getconf _NPROCESSORS_ONLN)

whole=$full
if awk -v d="$duration" -v n="$samples" -v s="$seconds" 'BEGIN { exit !(d <= n * s) }'; then
  whole=true
fi

if [[ "$whole" == true ]]; then
  starts=(whole)
else
  mapfile -t starts < <(awk -v d="$duration" -v n="$samples" -v s="$seconds" \
    'BEGIN { for (i = 0; i < n; i++) { t = (i + 0.5) * d / n - s / 2; if (t < 0) t = 0; printf "%.2f\n", t } }')
fi

workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

# Each converted frame is paired with the reference frame nearest in time. libvmaf pairs a
# converted frame with the latest reference frame at or before it, so the reference is moved
# half a frame earlier to turn that into "nearest". Exact timestamps can't be used: mkv rounds
# them to the millisecond, so twins are often a fraction of a millisecond apart. Pairing by
# frame order isn't used either: after a frame dropped during conversion, every pair is off.
# Variable frame rate videos have no FRAME_RATE, so 30 fps is assumed for frame offsets.
align_seconds=3
max_offset=2
# PSNR gap, in dB, before another alignment counts as clearly better than the timestamps'
mismatch_margin=3
score_size=${size/x/:}
reference_scale=
if [[ -n "$display_height" ]]; then
  score_size=$(awk -F: -v h="$display_height" '{ w = int($1 * h / $2 / 2 + 0.5) * 2; print w ":" h }' <<<"$score_size")
  reference_scale="scale=$score_size:flags=bicubic,"
fi
converted_chain="scale=$score_size:flags=bicubic,format=yuv420p10le"

# Reference chain that pairs each converted frame with the reference frame <offset> frames later
reference_chain() {
  local offset=$1
  echo "${reference_scale}format=yuv420p10le,setpts='PTS-if(gt(FRAME_RATE,0),($offset+0.5)/FRAME_RATE,$offset/30+0.005)/TB'"
}

alignment_psnr() {
  local offset=$1
  shift
  ffmpeg -hide_banner -nostats "$@" -i "$converted" "$@" -i "$reference" \
    -filter_complex "[0:v]${converted_chain}[c];[1:v]$(reference_chain "$offset")[r];[c][r]psnr" \
    -f null - 2>&1 | awk -F'average:' '/average:/ { split($2, a, " "); print (a[1] == "inf" ? 1000 : a[1]) }'
}

# Only warns: the pairing always follows the timestamps
check_alignment() {
  local what=$1 offset psnr best=0 best_psnr timestamp_psnr
  shift
  timestamp_psnr=$(alignment_psnr 0 "$@")
  best_psnr=$timestamp_psnr
  for ((offset = -max_offset; offset <= max_offset; offset++)); do
    ((offset == 0)) && continue
    psnr=$(alignment_psnr "$offset" "$@")
    if awk -v a="$psnr" -v b="$best_psnr" 'BEGIN { exit !(a > b) }'; then
      best=$offset
      best_psnr=$psnr
    fi
  done
  if ((best != 0)) && awk -v a="$best_psnr" -v b="$timestamp_psnr" -v m="$mismatch_margin" 'BEGIN { exit !(a - b > m) }'; then
    echo "WARNING: in $what, the frames of the two videos probably don't line up." >&2
    echo "  $(basename "$converted") matches $(basename "$reference") clearly better when offset by ${best#-} frame(s) from what its timestamps say." >&2
    echo "  This usually means one video has shifted or renumbered timestamps (for example, rewritten by" >&2
    echo "  another tool), so the score below compares different moments and reads lower than the real quality." >&2
  fi
}

index=0
for start in "${starts[@]}"; do
  index=$((index + 1))
  seek_args=()
  align_args=(-t "$align_seconds")
  label="whole video"
  what="the video"
  if [[ "$start" != whole ]]; then
    seek_args=(-ss "$start" -t "$seconds")
    align_args=(-ss "$start" -t "$align_seconds")
    label="start: ${start}s"
    what="clip $index"
  fi

  echo "clip $index/${#starts[@]} ($label)" >&2
  check_alignment "$what" "${align_args[@]}"
  printf -v log_path '%s/%02d.json' "$workdir" "$index"

  ffmpeg -hide_banner -loglevel error -nostats \
    "${seek_args[@]}" -i "$converted" \
    "${seek_args[@]}" -i "$reference" \
    -filter_complex "[0:v]${converted_chain}[converted];[1:v]$(reference_chain 0)[reference];[converted][reference]libvmaf=model=version=$model:n_threads=$threads:log_fmt=json:log_path=$log_path" \
    -f null -
done

echo "VMAF guide: 95+ can't tell apart | 90-95 very good | 80-90 good, small loss if you look"
echo "            70-80 visible loss | under 70 poor. Check \"1% low\" too: it shows the worst moments."
echo

jq -s -r '
  def r: . * 100 | round / 100;
  def mean: add / length;
  map([.frames[].metrics.vmaf]) as $clips
  | ($clips | add | sort) as $v
  | ($v | length) as $n
  | def pct($p): $v[(($n - 1) * $p / 100) | floor];
    def below($t): ([$v[] | select(. < $t)] | length) / $n * 100;
  "frames:         \($n)",
  "mean:           \($v | mean | r)",
  "harmonic mean:  \($n / ($v | map(1 / (if . < 0.01 then 0.01 else . end)) | add) | r)",
  "min:            \($v[0] | r)",
  "1% low:         \(pct(1) | r)",
  "5% low:         \(pct(5) | r)",
  "max:            \($v[-1] | r)",
  "below 90:       \(below(90) | r)% of frames",
  "below 80:       \(below(80) | r)% of frames",
  "",
  ($clips | to_entries[] | "clip \(.key + 1): mean \(.value | mean | r), min \(.value | min | r)")
' "$workdir"/*.json
