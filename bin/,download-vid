#!/usr/bin/env bash
set -e

stamp="${XDG_CACHE_HOME:-$HOME/.cache}/download-vid/yt-dlp-upgrade"
mkdir -p "$(dirname "$stamp")"

if [[ "$(cat "$stamp" 2>/dev/null)" != "$(date +%F)" ]]; then
  if pip install -U "yt-dlp[default,curl-cffi]"; then
    date +%F >"$stamp"
  fi
fi

sort_args=()
extra_args=()
rest=()

for arg in "$@"; do
  case "$arg" in
    --1080p) sort_args+=(-S "res:1080") ;;
    --compat)
      sort_args+=(-S "vcodec:h264,res,fps,acodec:m4a")
      extra_args+=(--merge-output-format mp4)
      ;;
    --unsafe) extra_args+=(--compat-options allow-unsafe-ext --no-check-certificate) ;;
    *) rest+=("$arg") ;;
  esac
done

yt-dlp \
  --download-archive "yt-dlp-archive.log" \
  --ignore-errors \
  --add-metadata \
  --all-subs \
  --embed-subs \
  --embed-thumbnail \
  --format "bestvideo+bestaudio/best" \
  --output "%(title).130s [%(height)s] (%(uploader_id)s - %(id)s).%(ext)s" \
  --extractor-args "generic:impersonate" \
  "${sort_args[@]}" \
  "${extra_args[@]}" \
  "${rest[@]}"
