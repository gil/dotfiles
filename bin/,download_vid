#!/usr/bin/env bash
set -e

yt-dlp \
  --download-archive "yt-dlp-archive.log" \
  --ignore-errors \
  --add-metadata \
  --all-subs \
  --embed-subs \
  --embed-thumbnail \
  --format "bestvideo+bestaudio/best" \
  --output "%(title).150s [%(height)s] (%(uploader_id)s - %(id)s).%(ext)s" \
  --extractor-args "generic:impersonate" \
  "$@"
