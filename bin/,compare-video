#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 2 ]] || { echo "usage: ,compare-video LEFT RIGHT" >&2; exit 1; }

# mpv's [vidN] labels are track IDs, counting every video stream in file order:
# embedded cover art takes a slot even though --audio-display=no hides it, and
# external tracks are numbered after all of the main file's.
video_track_count() {
  ffprobe -v error -select_streams v -show_entries stream=index \
    -of default=nk=1:nw=1 "$1" | wc -l
}

first_real_video_track() {
  ffprobe -v error -select_streams v -show_entries stream_disposition=attached_pic \
    -of default=nk=1:nw=1 "$1" | grep -n '^0$' | head -1 | cut -d: -f1
}

left=$(first_real_video_track "$1")
right=$(first_real_video_track "$2")
[[ -n "$left" ]] || { echo "no video track in $1" >&2; exit 1; }
[[ -n "$right" ]] || { echo "no video track in $2" >&2; exit 1; }
right=$(( $(video_track_count "$1") + right ))

# Not hstack: it pairs frames by exact timestamp, and mkv rounds those to the millisecond,
# so the right side often shows the previous frame. Overlay outputs one frame per left frame
# using the latest right frame at or before it; shifting the right half a frame earlier turns
# that into "nearest frame". Variable frame rate videos have no FRAME_RATE, so 5ms is used.
shift_right="setpts='PTS-if(gt(FRAME_RATE,0),0.5/FRAME_RATE,0.005)/TB'"
mpv --loop --fs --lavfi-complex="[vid${left}]pad=iw*2:ih[l];[vid${right}]${shift_right}[r];[l][r]overlay=x=W/2[vo]" \
  "$1" --external-file="$2"
